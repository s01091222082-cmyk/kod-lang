숫자 승리 = 0
숫자 패배 = 0
숫자 무승부 = 0
글자 나 = ''
글자 컴퓨터 = ''

말해('=== KOD 가위바위보 ===')
말해('가위 / 바위 / 보 입력')
말해('끝을 입력하면 종료합니다.')

계속해(나 않다 '끝')
    나 = 입력('당신의 선택 >> ')

    만약(나 않다 '가위' 그리고 나 않다 '바위' 그리고 나 않다 '보' 그리고 나 않다 '끝')
        말해('잘못된 입력입니다!')
    아니면
        만약(나 않다 '끝')
            컴퓨터 = 주사위.고르기(['가위', '바위', '보'])
            말해('컴퓨터:')
            말해(컴퓨터)

            만약(나 == 컴퓨터)
                말해('무승부!')
                무승부 = 무승부 + 1
            또아니면(나 == '가위' 그리고 컴퓨터 == '보')
                말해('승리!')
                승리 = 승리 + 1
            또아니면(나 == '바위' 그리고 컴퓨터 == '가위')
                말해('승리!')
                승리 = 승리 + 1
            또아니면(나 == '보' 그리고 컴퓨터 == '바위')
                말해('승리!')
                승리 = 승리 + 1
            아니면
                말해('패배!')
                패배 = 패배 + 1

            말해('--- 현재 전적 ---')
            말해('승리:')
            말해(승리)
            말해('패배:')
            말해(패배)
            말해('무승부:')
            말해(무승부)

말해('게임 종료!')
말해('=== 최종 전적 ===')
말해('승리:')
말해(승리)
말해('패배:')
말해(패배)
말해('무승부:')
말해(무승부)